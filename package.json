{
  "name": "vtnexa",
  "private": true,
  "version": "1.0.6",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": "24.18.0"
  },
  "type": "module",
  "scripts": {
    "sync-monaco": "node scripts/sync-monaco.mjs",
    "sync-skills": "node scripts/sync-skills.mjs",
    "provision-node": "node scripts/provision-node.mjs",
    "stage-sidecar": "node scripts/stage-sidecar.mjs",
    "pretauri": "pnpm run stage-sidecar && pnpm run sync-skills",
    "predev": "pnpm run sync-skills",
    "dev": "vite",
    "prebuild": "pnpm run sync-monaco && pnpm run sync-skills",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "install-local": "bash scripts/install-local.sh",
    "test": "vitest run && pnpm test:node",
    "test:node": "node --test --test-concurrency=1 scripts/tauri-driver-client.test.mjs scripts/sign-windows.test.mjs scripts/release-preflight.test.mjs scripts/verify-release.test.mjs scripts/windows-signing-setup.test.mjs",
    "test:tauri-smoke": "node scripts/tauri-windows-smoke.mjs",
    "test:tauri-smoke-linux": "bash scripts/tauri-smoke.sh --build",
    "test:provision": "node --test scripts/provision-node.test.mjs",
    "test:sidecar": "node --test sidecar/browser/runtime.test.js sidecar/browser/server.test.js",
    "coverage": "vitest run --coverage",
    "lint": "eslint src/ --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.17",
    "marked": "^18.1.1",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "license": "Apache-2.0",
  "author": "VTNexa contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/velsrocky/vtnexa.git"
  },
  "bugs": {
    "url": "https://github.com/velsrocky/vtnexa/issues"
  },
  "keywords": [
    "ai",
    "agent",
    "tauri",
    "local-first",
    "ollama",
    "code-editor",
    "review-gated"
  ]
}
