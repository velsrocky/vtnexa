{
  "name": "vtnexa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "sync-monaco": "rm -rf public/vs && mkdir -p public && cp -r node_modules/monaco-editor/min/vs public/vs",
    "stage-sidecar": "rm -rf src-tauri/sidecar-stage && mkdir -p src-tauri/sidecar-stage/browser && cp sidecar/browser/server.js sidecar/browser/package.json src-tauri/sidecar-stage/browser/ && cp -rL sidecar/browser/node_modules src-tauri/sidecar-stage/browser/node_modules",
    "pretauri": "pnpm run stage-sidecar",
    "predev": "pnpm run sync-monaco",
    "dev": "vite",
    "prebuild": "pnpm run sync-monaco",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "install-local": "bash scripts/install-local.sh",
    "test": "vitest run"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-opener": "^2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.15",
    "marked": "^18.0.12",
    "monaco-editor": "^0.56.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^30.0.1",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.0"
  },
  "license": "Apache-2.0",
  "author": "VTNexa contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/velsrocky/vtnexa.git"
  },
  "bugs": {
    "url": "https://github.com/velsrocky/vtnexa/issues"
  },
  "keywords": [
    "ai",
    "agent",
    "tauri",
    "local-first",
    "ollama",
    "code-editor",
    "review-gated"
  ]
}
